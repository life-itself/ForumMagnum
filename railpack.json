{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "yarn install --frozen-lockfile --ignore-scripts"
      ]
    },
    "build": {
      "inputs": [
        {
          "step": "install"
        }
      ],
      "commands": [
        "npm rebuild bcrypt",
        "cd ckEditor && yarn install --frozen-lockfile --ignore-scripts --ignore-optional && yarn build",
        "ENV_NAME=stage1Lw FORUM_TYPE=LessWrong PG_URL=\"$PG_URL_BUILD\" yarn generate",
        "ENV_NAME=stage1Lw FORUM_TYPE=LessWrong PG_URL=\"$PG_URL_BUILD\" ./node_modules/.bin/next build"
      ]
    }
  }
}
